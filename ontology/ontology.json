    },
    {
      "@id": "rule:high-risk-opus",
      "conditions": [
        {
          "type": "risk",
          "values": [
            "high"
          ]
        }
      ],
      "confidence": 0.2,
      "effort": "high",
      "evidence": [
        "evidence:official-effort",
        "evidence:role-stats",
        "evidence:seed-measurements"
      ],
      "model": "claude-opus-5-5",
      "priority": 200,
      "reason": "Security, concurrency, and timing risks require the higher Opus effort."
    },
    {
      "@id": "rule:plan-review-opus",
      "conditions": [
        {
          "type": "role",
          "values": [
            "plan",
            "review"
          ]
        }
      ],
      "confidence": 0.2,
      "effort": "high",
      "evidence": [
        "evidence:official-effort",
        "evidence:role-stats"
      ],
      "model": "claude-opus-5-5",
      "priority": 190,
      "reason": "Planning and review use the measured high-effort Opus placement."
    }
